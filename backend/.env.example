# Copy to .env. The app does not read .env itself: export the variables or use `docker run --env-file`.
# All values shown are the defaults.

# Storage
DATA_DIR=./data
# Delete analyses older than N days at startup (0 = keep forever)
RETENTION_DAYS=0

# Models
# folder holding the .keras files (default: repository root)
# MODEL_DIR=
RESNET50_MODEL_FILE=resnet50_model.keras
CUSTOM_CNN_MODEL_FILE=custom_cnn_model.keras
# default: <repo>/model_comparison_results.csv
# METRICS_CSV=
# default: <repo>/ml/results/model_insights.json
# INSIGHTS_JSON=
# needed for the ResNet50 Lambda layer; only use trusted model files
ALLOW_UNSAFE_LAMBDA_LOAD=true
WARMUP=false
MAX_CONCURRENT_INFERENCES=1
INFERENCE_WAIT_SECONDS=60

# Safety: results with a top probability below this are flagged low_confidence
CONFIDENCE_THRESHOLD=0.6

# Upload limits / abuse protection
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000
# per client IP on POST /api/analyze; 0 = off
RATE_LIMIT_PER_MIN=30

# Access control: when set, every /api route except /api/health needs the X-API-Key header
API_KEY=

# HTTP / logging
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
